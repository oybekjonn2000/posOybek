# RestaurantPOS Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to source control

# ========================================
# DATABASE
# ========================================
DATABASE_URL=jdbc:postgresql://localhost:5432/restaurant_pos
DATABASE_USERNAME=pos_user
DATABASE_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# ========================================
# SECURITY
# ========================================
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_MINIMUM_256_BITS_SECRET_KEY_FOR_JWT_SIGNING_HERE

# ========================================
# APPLICATION
# ========================================
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# ========================================
# DEVICE
# ========================================
DEVICE_ID=
DEVICE_NAME=POS-01
DEVICE_TYPE=POS
TENANT_ID=

# ========================================
# CLOUD SYNC (optional)
# ========================================
CLOUD_API_URL=
CLOUD_API_KEY=
SYNC_INTERVAL=30000

# ========================================
# BACKUP
# ========================================
BACKUP_PATH=C:/ProgramData/RestaurantPOS/backups

# ========================================
# LOGGING
# ========================================
LOG_PATH=logs

# ========================================
# DOCKER
# ========================================
DB_PASSWORD=CHANGE_ME_SECURE_PASSWORD
PGADMIN_EMAIL=admin@restaurantpos.local
PGADMIN_PASSWORD=CHANGE_ME
